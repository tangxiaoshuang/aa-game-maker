# Database & Cache (Podman local infra)
DATABASE_URL=postgresql://aagame:aagame_dev_password@127.0.0.1:5432/aa_game_maker
REDIS_URL=redis://127.0.0.1:6379

# Object Storage (RustFS S3-compatible via Podman)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aagameadmin
S3_SECRET_KEY=aagame_s3_dev_password
S3_BUCKET_ASSETS=aa-game-assets
S3_BUCKET_RELEASES=aa-game-releases

# Service Ports & Origins
WEB_PORT=3000
PLAYER_PORT=3001
ROOM_SERVER_PORT=4000
WORKERD_PORT=4001
API_PORT=4002

NEXT_PUBLIC_PLAYER_ORIGIN=http://localhost:3001
NEXT_PUBLIC_ROOM_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_ROOM_WS_URL=ws://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4002
