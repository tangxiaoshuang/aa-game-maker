{
  "name": "@aa-game/local-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aa-game-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aa-game/harness-core": "workspace:*",
    "@aa-game/harness-mcp": "workspace:*",
    "@aa-game/protocol": "workspace:*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
